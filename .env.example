# Server Configuration
PORT=3978
NODE_ENV=development

# Microsoft Teams Bot
MICROSOFT_APP_ID=your-app-id-here
MICROSOFT_APP_PASSWORD=your-app-password-here
BOT_ID=your-bot-id-here

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teams_approval
DB_USER=postgres
DB_PASSWORD=your-db-password-here

# Azure AD / Entra ID
TENANT_ID=your-tenant-id-here
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here

# Application URLs
APP_BASE_URL=https://your-server.com
TEAMS_APP_URL=https://your-server.com

# Teams Channels Configuration
# HR Channel ID - get this from Teams (see docs/SETUP.md)
HR_CHANNEL_ID=19:your-channel-id@thread.tacv2
# Send tickets to HR channel (true) or direct message (false)
SEND_TO_HR_CHANNEL=true
# Always send creator notifications via DM
CREATOR_NOTIFICATION_DM=true

# Logging
LOG_LEVEL=info
