# Server Configuration
PORT=3978
NODE_ENV=development

# Microsoft Teams Bot
MICROSOFT_APP_ID=your-app-id-here
MICROSOFT_APP_PASSWORD=your-app-password-here
BOT_ID=your-bot-id-here

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teams_approval
DB_USER=postgres
DB_PASSWORD=your-db-password-here

# Azure AD / Entra ID
TENANT_ID=your-tenant-id-here
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here

# Application URLs
APP_BASE_URL=https://your-server.com
TEAMS_APP_URL=https://your-server.com

# Teams Channels Configuration
# HR Channel ID - get this from Teams (see docs/SETUP.md)
HR_CHANNEL_ID=19:your-channel-id@thread.tacv2
# Send tickets to HR channel (true) or direct message (false)
SEND_TO_HR_CHANNEL=true
# Always send creator notifications via DM
CREATOR_NOTIFICATION_DM=true

# SMTP Configuration (for fleet notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=ETILOG System <noreply@example.com>

# Logging
LOG_LEVEL=info

# Access control mode: how module permissions are decided.
#   legacy   the old role lists decide; the permission matrix is ignored.
#            Panic switch - restores the exact pre-matrix behaviour.
#   shadow   the role lists still decide, but every check is also resolved
#            through the matrix and disagreements are logged as
#            "ACCESS SHADOW MISMATCH". Behaviourally identical to legacy.
#   enforce  the role/permission matrix decides.
# Switching back is this variable plus a restart - no redeploy, no DB change.
ACCESS_CONTROL_MODE=shadow

# Production change log retention.
#   PRODUCTION_LOG_DETAIL_DAYS  how long a change stays restorable. After this
#                               the before/after snapshot is dropped; the record
#                               of what happened and who did it remains.
#   PRODUCTION_LOG_PURGE_DAYS   how long the record itself is kept. 0 = forever.
# Measured at ~537 bytes per change with the snapshot, ~238 without. At 200
# changes a day these defaults settle the table at roughly 50 MB.
PRODUCTION_LOG_DETAIL_DAYS=90
PRODUCTION_LOG_PURGE_DAYS=1095

# ---------------------------------------------------------------- SAP Business One
# Read-only link to SAP over the OpenVPN tunnel, used by the production plan to
# tell the planner whether the constructions and bags for a batch are there.
#
# The app never writes to SAP. That is enforced in src/services/sapClient.js,
# where the only method that reaches business data cannot send anything but GET.
#
# Left false everywhere until the mirror has been verified: with SAP_ENABLED
# unset or false the sync never starts and the app behaves exactly as before.
SAP_ENABLED=false
SAP_HOST=192.168.18.41
SAP_PORT=50000
SAP_DB=Etilog_C
SAP_USER=
SAP_PASSWORD=

# The Service Layer certificate is self-signed and expired, so it is pinned by
# SHA-256 fingerprint - we accept exactly this certificate and nothing else,
# which is stricter than a chain check. Read it with:
#   openssl s_client -connect 192.168.18.41:50000 </dev/null 2>/dev/null \
#     | openssl x509 -noout -fingerprint -sha256
# When Softip reissues it properly, set SAP_VERIFY_TLS=true and drop the pin.
SAP_FINGERPRINT=
SAP_VERIFY_TLS=false

# How often the mirror is refreshed, in minutes (clamped to 5-60). One pass is
# a couple of hundred requests over the tunnel and takes a few seconds.
SAP_SYNC_MINUTES=15

# A construction bought from a partner (ASPF, PL) shows up as a purchased _01
# component costing hundreds of euros - the ten we measured ran 210 to 794 EUR,
# while fasteners and labels in the same BOMs ran 0.20 to 12. This threshold
# sits in that gap.
SAP_CONSTRUCTION_MIN_PRICE=50
