# Server Configuration
PORT=3978
NODE_ENV=development

# Microsoft Teams Bot
MICROSOFT_APP_ID=your-app-id-here
MICROSOFT_APP_PASSWORD=your-app-password-here
BOT_ID=your-bot-id-here

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teams_approval
DB_USER=postgres
DB_PASSWORD=your-db-password-here

# Azure AD / Entra ID
TENANT_ID=your-tenant-id-here
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here

# Application URLs
APP_BASE_URL=https://your-server.com
TEAMS_APP_URL=https://your-server.com

# Teams Channels Configuration
# HR Channel ID - get this from Teams (see docs/SETUP.md)
HR_CHANNEL_ID=19:your-channel-id@thread.tacv2
# Send tickets to HR channel (true) or direct message (false)
SEND_TO_HR_CHANNEL=true
# Always send creator notifications via DM
CREATOR_NOTIFICATION_DM=true

# SMTP Configuration (for fleet notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=ETILOG System <noreply@example.com>

# Logging
LOG_LEVEL=info

# Access control mode: how module permissions are decided.
#   legacy   the old role lists decide; the permission matrix is ignored.
#            Panic switch - restores the exact pre-matrix behaviour.
#   shadow   the role lists still decide, but every check is also resolved
#            through the matrix and disagreements are logged as
#            "ACCESS SHADOW MISMATCH". Behaviourally identical to legacy.
#   enforce  the role/permission matrix decides.
# Switching back is this variable plus a restart - no redeploy, no DB change.
ACCESS_CONTROL_MODE=shadow

# Production change log retention.
#   PRODUCTION_LOG_DETAIL_DAYS  how long a change stays restorable. After this
#                               the before/after snapshot is dropped; the record
#                               of what happened and who did it remains.
#   PRODUCTION_LOG_PURGE_DAYS   how long the record itself is kept. 0 = forever.
# Measured at ~537 bytes per change with the snapshot, ~238 without. At 200
# changes a day these defaults settle the table at roughly 50 MB.
PRODUCTION_LOG_DETAIL_DAYS=90
PRODUCTION_LOG_PURGE_DAYS=1095
