# ============================================
# ETILOG TEAMS APPROVAL APP - INFOMANIAK VPS
# ============================================
# Template for Infomaniak VPS deployment
# Copy this to .env and fill in the values

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3978
NODE_ENV=production

# ============================================
# MICROSOFT TEAMS BOT CREDENTIALS
# ============================================
# Get these from Azure Portal > Azure Bot registration
MICROSOFT_APP_ID=your-app-id-from-azure
MICROSOFT_APP_PASSWORD=your-app-password-from-azure
BOT_ID=your-bot-id-from-azure

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Note: DB_HOST is set automatically in docker-compose
# to "teams-app-db" (the container name)
DB_HOST=teams-app-db
DB_PORT=5432
DB_NAME=teams_approval
DB_USER=postgres
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE

# ============================================
# AZURE AD / ENTRA ID
# ============================================
# ETILOG Tenant ID
TENANT_ID=68fad620-da38-42f1-bff7-f02d56a8b293
# Client ID (same as MICROSOFT_APP_ID)
CLIENT_ID=your-app-id-from-azure
# Client Secret (same as MICROSOFT_APP_PASSWORD)
CLIENT_SECRET=your-app-password-from-azure

# ============================================
# APPLICATION URLS - INFOMANIAK
# ============================================
# Update this to your actual subdomain
APP_BASE_URL=https://portal.etilog.com
TEAMS_APP_URL=https://portal.etilog.com

# ============================================
# TEAMS CHANNELS CONFIGURATION
# ============================================
# HR Channel ID - General channel in Human Resources team
HR_CHANNEL_ID=19:4141e6983e924871be8dc35dfd2c5ff1@thread.tacv2

# Send approval cards to HR channel (all members see)
SEND_TO_HR_CHANNEL=true

# Send creator notifications via DM (private)
CREATOR_NOTIFICATION_DM=true

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# IMPORTANT NOTES FOR INFOMANIAK:
# ============================================
# 1. DB_HOST must be "teams-app-db" (Docker container name)
# 2. APP_BASE_URL must match the Traefik Host() rule
# 3. After deployment, update Azure Bot messaging endpoint to:
#    https://portal.etilog.com/api/messages
# 4. Make sure DNS A record points to Infomaniak VPS IP

# Access control mode: how module permissions are decided.
#   legacy   the old role lists decide; the permission matrix is ignored.
#            Panic switch - restores the exact pre-matrix behaviour.
#   shadow   the role lists still decide, but every check is also resolved
#            through the matrix and disagreements are logged as
#            "ACCESS SHADOW MISMATCH". Behaviourally identical to legacy.
#   enforce  the role/permission matrix decides.
# Switching back is this variable plus a restart - no redeploy, no DB change.
ACCESS_CONTROL_MODE=shadow
