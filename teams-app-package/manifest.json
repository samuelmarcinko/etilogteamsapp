{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.2",
  "id": "39cb02be-f50d-4e06-afda-ec0ce359e2a8",
  "packageName": "com.etilog.approval",
  "developer": {
    "name": "ETILOG",
    "websiteUrl": "https://etilog.com",
    "privacyUrl": "https://etilog.com/privacy",
    "termsOfUseUrl": "https://etilog.com/terms"
  },
  "name": {
    "short": "Approval Bot",
    "full": "ETILOG Internal Approval Bot"
  },
  "description": {
    "short": "Internal approval system for HR and Accounting",
    "full": "ETILOG Internal Approval Bot helps manage approval requests for HR and Accounting departments. Submit tickets and get approvals directly in Teams."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#d9000c",
  "bots": [
    {
      "botId": "39cb02be-f50d-4e06-afda-ec0ce359e2a8",
      "scopes": [
        "personal",
        "team",
        "groupchat"
      ],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "staticTabs": [
    {
      "entityId": "dashboard",
      "name": "Dashboard",
      "contentUrl": "https://teams.etilog.com/pages/dashboard.html",
      "scopes": [
        "personal"
      ]
    },
    {
      "entityId": "createRequest",
      "name": "Create Request",
      "contentUrl": "https://teams.etilog.com/pages/create.html",
      "scopes": [
        "personal"
      ]
    },
    {
      "entityId": "myRequests",
      "name": "My Requests",
      "contentUrl": "https://teams.etilog.com/pages/my-requests.html",
      "scopes": [
        "personal"
      ]
    },
    {
      "entityId": "approvals",
      "name": "Approvals",
      "contentUrl": "https://teams.etilog.com/pages/approvals.html",
      "scopes": [
        "personal"
      ]
    }
  ],
  "configurableTabs": [
    {
      "configurationUrl": "https://teams.etilog.com/",
      "canUpdateConfiguration": true,
      "scopes": [
        "team",
        "groupchat"
      ]
    }
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [
    "teams.etilog.com"
  ]
